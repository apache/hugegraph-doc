-ai/rest-api/"}],"id":"/docs/quickstart/hugegraph-ai/","kind":"section","markdown":"https://hugegraph.apache.org/docs/quickstart/hugegraph-ai/index.md","title":"HugeGraph-AI","url":"https://hugegraph.apache.org/docs/quickstart/hugegraph-ai/"}],"kind":"external","title":"Components","url":"/docs/quickstart/hugegraph/"},{"children":[{"children":[{"id":"/docs/clients/hugegraph-client/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/hugegraph-client/index.md","title":"HugeGraph Java Client","url":"https://hugegraph.apache.org/docs/clients/hugegraph-client/"},{"id":"/docs/clients/gremlin-console/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/gremlin-console/index.md","title":"Gremlin Console","url":"https://hugegraph.apache.org/docs/clients/gremlin-console/"},{"children":[{"description":"Graphs REST API: Manage graph instance lifecycle including creating, querying, cloning, clearing, and deleting graph databases.","id":"/docs/clients/restful-api/graphs/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/graphs/index.md","title":"Graphs","url":"https://hugegraph.apache.org/docs/clients/restful-api/graphs/"},{"description":"Graphspace REST API: Multi-tenancy and resource isolation for creating, viewing, updating, and deleting graph spaces with prerequisites and constraints.","id":"/docs/clients/restful-api/graphspace/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/graphspace/index.md","title":"Graphspace","url":"https://hugegraph.apache.org/docs/clients/restful-api/graphspace/"},{"description":"Authentication REST API: Manage users, roles, permissions, and access control to implement fine-grained graph data security.","id":"/docs/clients/restful-api/auth/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/auth/index.md","title":"Authentication","url":"https://hugegraph.apache.org/docs/clients/restful-api/auth/"},{"description":"Schema REST API: Query the complete schema definition of a graph, including property keys, vertex labels, edge labels, and index labels.","id":"/docs/clients/restful-api/schema/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/schema/index.md","title":"Schema","url":"https://hugegraph.apache.org/docs/clients/restful-api/schema/"},{"description":"PropertyKey REST API: Define data types and cardinality constraints for all properties in the graph, serving as fundamental schema elements.","id":"/docs/clients/restful-api/propertykey/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/propertykey/index.md","title":"PropertyKey","url":"https://hugegraph.apache.org/docs/clients/restful-api/propertykey/"},{"description":"VertexLabel REST API: Define vertex types, ID strategies, and associated properties that determine vertex structure and constraints.","id":"/docs/clients/restful-api/vertexlabel/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/vertexlabel/index.md","title":"VertexLabel","url":"https://hugegraph.apache.org/docs/clients/restful-api/vertexlabel/"},{"description":"EdgeLabel REST API: Define edge types and relationship constraints between source and target vertices to construct graph connection rules.","id":"/docs/clients/restful-api/edgelabel/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/edgelabel/index.md","title":"EdgeLabel","url":"https://hugegraph.apache.org/docs/clients/restful-api/edgelabel/"},{"description":"IndexLabel REST API: Create indexes on vertex and edge properties to accelerate property-based queries and filtering operations.","id":"/docs/clients/restful-api/indexlabel/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/indexlabel/index.md","title":"IndexLabel","url":"https://hugegraph.apache.org/docs/clients/restful-api/indexlabel/"},{"description":"Vertex REST API: Create, query, update, and delete vertex data in the graph with support for batch operations and conditional filtering.","id":"/docs/clients/restful-api/vertex/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/vertex/index.md","title":"Vertex","url":"https://hugegraph.apache.org/docs/clients/restful-api/vertex/"},{"description":"Edge REST API: Create, query, update, and delete relationship data between vertices with support for batch operations and directional queries.","id":"/docs/clients/restful-api/edge/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/edge/index.md","title":"Edge","url":"https://hugegraph.apache.org/docs/clients/restful-api/edge/"},{"description":"Variable REST API: Store and manage key-value pairs as global variables for graph-level configuration and state management.","id":"/docs/clients/restful-api/variable/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/variable/index.md","title":"Variable","url":"https://hugegraph.apache.org/docs/clients/restful-api/variable/"},{"description":"Gremlin REST API: Execute Gremlin graph traversal language scripts via HTTP interface.","id":"/docs/clients/restful-api/gremlin/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/gremlin/index.md","title":"Gremlin","url":"https://hugegraph.apache.org/docs/clients/restful-api/gremlin/"},{"description":"Cypher REST API: Execute OpenCypher declarative graph query language via HTTP interface.","id":"/docs/clients/restful-api/cypher/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/cypher/index.md","title":"Cypher","url":"https://hugegraph.apache.org/docs/clients/restful-api/cypher/"},{"description":"Traverser REST API: Execute complex graph algorithms and path queries including shortest path, k-neighbors, similarity computation, and advanced analytics.","id":"/docs/clients/restful-api/traverser/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/traverser/index.md","title":"Traverser","url":"https://hugegraph.apache.org/docs/clients/restful-api/traverser/"},{"description":"Task REST API: Query and manage asynchronous task execution status for long-running operations like index rebuilding and graph traversals.","id":"/docs/clients/restful-api/task/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/task/index.md","title":"Task","url":"https://hugegraph.apache.org/docs/clients/restful-api/task/"},{"description":"Rebuild REST API: Rebuild graph schema indexes to ensure consistency between index data and graph data.","id":"/docs/clients/restful-api/rebuild/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/rebuild/index.md","title":"Rebuild","url":"https://hugegraph.apache.org/docs/clients/restful-api/rebuild/"},{"description":"Rank REST API: Execute graph node ranking algorithms such as PageRank and Personalized PageRank for centrality analysis.","id":"/docs/clients/restful-api/rank/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/rank/index.md","title":"Rank","url":"https://hugegraph.apache.org/docs/clients/restful-api/rank/"},{"description":"Metrics REST API: Retrieve runtime performance metrics, statistics, and health status data of the system.","id":"/docs/clients/restful-api/metrics/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/metrics/index.md","title":"Metrics","url":"https://hugegraph.apache.org/docs/clients/restful-api/metrics/"},{"description":"Other REST API: Provide auxiliary functions such as system version query and API version information.","id":"/docs/clients/restful-api/other/","kind":"page","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/other/index.md","title":"Other","url":"https://hugegraph.apache.org/docs/clients/restful-api/other/"}],"id":"/docs/clients/restful-api/","kind":"section","markdown":"https://hugegraph.apache.org/docs/clients/restful-api/index.md","title":"RESTful API","url":"https://hugegraph.apache.org/docs/clients/restful-api/"}],"id":"/docs/clients/","kind":"section","markdown":"https://hugegraph.apache.org/docs/clients/index.md","title":"Clients and APIs","url":"https://hugegraph.apache.org/docs/clients/"},{"children":[{"id":"/docs/quickstart/client/hugegraph-client/","kind":"page","markdown":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client/index.md","title":"Java-Client","url":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client/"},{"id":"/docs/quickstart/client/hugegraph-client-python/","kind":"page","markdown":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client-python/index.md","title":"Python Client","url":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client-python/"},{"id":"/docs/quickstart/client/hugegraph-client-go/","kind":"page","markdown":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client-go/index.md","title":"Go Client","url":"https://hugegraph.apache.org/docs/quickstart/client/hugegraph-client-go/"}],"id":"/docs/quickstart/client/","kind":"section","markdown":"https://hugegraph.apache.org/docs/quickstart/client/index.md","title":"HugeGraph Client","url":"https://hugegraph.apache.org/docs/quickstart/client/"},{"children":[{"id":"/docs/language/hugegraph-gremlin/","kind":"page","markdown":"https://hugegraph.apache.org/docs/language/hugegraph-gremlin/index.md","title":"Gremlin Query Language","url":"https://hugegraph.apache.org/docs/language/hugegraph-gremlin/"}],"id":"/docs/language/","kind":"section","markdown":"https://hugegraph.apache.org/docs/language/index.md","title":"Query Languages","url":"https://hugegraph.apache.org/docs/language/"},{"id":"/docs/guides/architectural/","kind":"page","markdown":"https://hugegraph.apache.org/docs/guides/architectural/index.md","title":"Architecture Overview","url":"https://hugegraph.apache.org/docs/guides/architect